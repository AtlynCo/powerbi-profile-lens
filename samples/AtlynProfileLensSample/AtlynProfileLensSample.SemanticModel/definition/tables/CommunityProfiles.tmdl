/// Offline synthetic sample data for Atlyn Profile Lens: community demographic profiles.
/// Defined as a DAX calculated table so the model has no data source, no credentials and
/// no refresh. Every value is generated by a deterministic function of the key and carries
/// no observation from any real statistical source.
/// Indicators are reported across five age bands: 0 to 17, 18 to 34, 35 to 49, 50 to 64, 65 and over.
table CommunityProfiles

	column Community
		summarizeBy: none
		isNameInferred
		sourceColumn: [Community]

		annotation SummarizationSetBy = Automatic

	column Period
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period]

		annotation SummarizationSetBy = Automatic

	column AgeBand
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeBand]
		sortByColumn: AgeOrder

		annotation SummarizationSetBy = Automatic

	column AgeOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeOrder]

		annotation SummarizationSetBy = Automatic

	column Settlement
		summarizeBy: none
		isNameInferred
		sourceColumn: [Settlement]

		annotation SummarizationSetBy = Automatic

	column Residents
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Residents]

		annotation SummarizationSetBy = Automatic

	column 'Median household income'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Median household income]

		annotation SummarizationSetBy = Automatic

	column 'Degree attainment rate'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Degree attainment rate]

		annotation SummarizationSetBy = Automatic

	column 'Health coverage rate'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Health coverage rate]

		annotation SummarizationSetBy = Automatic

	column 'Labor force participation'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Labor force participation]

		annotation SummarizationSetBy = Automatic

	column 'Housing cost burden'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Housing cost burden]

		annotation SummarizationSetBy = Automatic

	column Latitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Latitude]

		annotation SummarizationSetBy = Automatic

	column Longitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Longitude]

		annotation SummarizationSetBy = Automatic

	column Geometry
		summarizeBy: none
		isNameInferred
		sourceColumn: [Geometry]

		annotation SummarizationSetBy = Automatic

	measure 'Context value (CommunityProfiles)' = SUM(CommunityProfiles[Residents])

	measure 'Population by age band (CommunityProfiles)' = SUM(CommunityProfiles[Residents])

	measure 'Median income by age (CommunityProfiles)' = AVERAGE(CommunityProfiles[Median household income])

	measure 'Degree attainment by age (CommunityProfiles)' = AVERAGE(CommunityProfiles[Degree attainment rate])

	measure 'Selected latitude (CommunityProfiles)' = SELECTEDVALUE(CommunityProfiles[Latitude])

	measure 'Selected longitude (CommunityProfiles)' = SELECTEDVALUE(CommunityProfiles[Longitude])

	measure 'Selected geometry (CommunityProfiles)' = SELECTEDVALUE(CommunityProfiles[Geometry])

	partition CommunityProfiles = calculated
		mode: import
		source =
				DATATABLE(
				    "Community", STRING,
				    "Period", STRING,
				    "AgeBand", STRING,
				    "AgeOrder", INTEGER,
				    "Settlement", STRING,
				    "Residents", DOUBLE,
				    "Median household income", DOUBLE,
				    "Degree attainment rate", DOUBLE,
				    "Health coverage rate", DOUBLE,
