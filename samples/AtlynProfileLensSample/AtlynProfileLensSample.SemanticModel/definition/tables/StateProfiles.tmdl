/// Offline synthetic sample data for Atlyn Profile Lens: state demographic profiles.
/// Defined as a DAX calculated table so the model has no data source, no credentials and
/// no refresh. Every value is generated by a deterministic function of the key and carries
/// no observation from any real statistical source.
/// Indicators are reported across five age bands: 0 to 17, 18 to 34, 35 to 49, 50 to 64, 65 and over.
table StateProfiles

	column StateKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [StateKey]

		annotation SummarizationSetBy = Automatic

	column State
		summarizeBy: none
		isNameInferred
		sourceColumn: [State]

		annotation SummarizationSetBy = Automatic

	column AgeBand
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeBand]
		sortByColumn: AgeOrder

		annotation SummarizationSetBy = Automatic

	column AgeOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeOrder]

		annotation SummarizationSetBy = Automatic

	column Residents
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Residents]

		annotation SummarizationSetBy = Automatic

	column 'Median household income'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Median household income]

		annotation SummarizationSetBy = Automatic

	measure 'Context value' = SUM(StateProfiles[Residents])

	measure 'Population by age band' = SUM(StateProfiles[Residents])

	measure 'Median income by age' = AVERAGE(StateProfiles[Median household income])

	partition StateProfiles = calculated
		mode: import
		source =
				DATATABLE(
				    "StateKey", STRING,
				    "State", STRING,
				    "AgeBand", STRING,
				    "AgeOrder", INTEGER,
				    "Residents", DOUBLE,
