/// Offline synthetic sample data for Atlyn Profile Lens: Demographics & Community Profile Demo.
/// Defined as a DAX calculated table so the model has no data source, no credentials and no refresh.
/// Features 6 realistic demographic metric dimensions across population, income, education, health, labor, and housing:
///   - Metric A: Population Distribution by Age Band (0-17, 18-34, 35-49, 50-64, 65+)
///   - Metric B: Household Income Brackets (<$35k, $35k-$74k, $75k-$124k, $125k-$199k, $200k+)
///   - Metric C: Educational Attainment (Less than HS, HS Grad, Some College, Bachelor's, Graduate)
///   - Metric D: Community Health Indicators (Preventive Care, Physical Activity, Chronic Mgmt, Mental Wellness, Care Access)
///   - Metric E: Labor Force & Economic Participation Rate (%)
///   - Metric F: Housing & Community Infrastructure Index (Affordability & Quality quintiles)
table ProfileFacts

	column Entity
		summarizeBy: none
		isNameInferred
		sourceColumn: [Entity]

		annotation SummarizationSetBy = Automatic

	column WorldKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [WorldKey]

		annotation SummarizationSetBy = Automatic

	column ViewportWorldKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [ViewportWorldKey]

		annotation SummarizationSetBy = Automatic

	column StateKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [StateKey]

		annotation SummarizationSetBy = Automatic

	column CountyKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [CountyKey]

		annotation SummarizationSetBy = Automatic

	column Period
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period]

		annotation SummarizationSetBy = Automatic

	column Band
		summarizeBy: none
		isNameInferred
		sourceColumn: [Band]
		sortByColumn: BandOrder

		annotation SummarizationSetBy = Automatic

	column BandOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [BandOrder]

		annotation SummarizationSetBy = Automatic

	column Series
		summarizeBy: none
		isNameInferred
		sourceColumn: [Series]

		annotation SummarizationSetBy = Automatic

	column 'Metric A'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric A]

		annotation SummarizationSetBy = Automatic

	column 'Metric B'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric B]

		annotation SummarizationSetBy = Automatic

	column 'Metric C'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric C]

		annotation SummarizationSetBy = Automatic

	column 'Metric D'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric D]

		annotation SummarizationSetBy = Automatic

	column 'Metric E'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric E]

		annotation SummarizationSetBy = Automatic

	column 'Metric F'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric F]

		annotation SummarizationSetBy = Automatic

	column Latitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Latitude]

		annotation SummarizationSetBy = Automatic

	column Longitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Longitude]

		annotation SummarizationSetBy = Automatic

	column Geometry
		summarizeBy: none
		isNameInferred
		sourceColumn: [Geometry]

		annotation SummarizationSetBy = Automatic

	measure 'Context value' = SUM(ProfileFacts[Metric A])

	measure 'Selected latitude' = SELECTEDVALUE(ProfileFacts[Latitude])

	measure 'Selected longitude' = SELECTEDVALUE(ProfileFacts[Longitude])

	measure 'Selected geometry' = SELECTEDVALUE(ProfileFacts[Geometry])

	measure 'Population Distribution' = SUM(ProfileFacts[Metric A])

	measure 'Household Income Brackets' = SUM(ProfileFacts[Metric B])

	measure 'Educational Attainment' = SUM(ProfileFacts[Metric C])

	measure 'Community Health Indicators' = SUM(ProfileFacts[Metric D])

	measure 'Labor Force Participation' = SUM(ProfileFacts[Metric E])

	measure 'Housing & Infrastructure Index' = SUM(ProfileFacts[Metric F])

	partition ProfileFacts = calculated
		mode: import
		source =
				DATATABLE(
				    "Entity", STRING,
				    "WorldKey", STRING,
				    "ViewportWorldKey", STRING,
				    "StateKey", STRING,
				    "CountyKey", STRING,
				    "Period", STRING,
				    "Band", STRING,
				    "BandOrder", INTEGER,
				    "Series", STRING,
				    "Metric A", DOUBLE,
				    "Metric B", DOUBLE,
				    "Metric C", DOUBLE,
				    "Metric D", DOUBLE,
				    "Metric E", DOUBLE,
				    "Metric F", DOUBLE,
				    "Latitude", DOUBLE,
				    "Longitude", DOUBLE,
