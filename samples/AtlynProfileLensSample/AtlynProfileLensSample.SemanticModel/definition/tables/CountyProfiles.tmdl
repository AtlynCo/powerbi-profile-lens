/// Offline synthetic sample data for Atlyn Profile Lens: county demographic profiles.
/// Defined as a DAX calculated table so the model has no data source, no credentials and
/// no refresh. Every value is generated by a deterministic function of the key and carries
/// no observation from any real statistical source.
/// Indicators are reported across five age bands: 0 to 17, 18 to 34, 35 to 49, 50 to 64, 65 and over.
table CountyProfiles

	column CountyKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [CountyKey]

		annotation SummarizationSetBy = Automatic

	column County
		summarizeBy: none
		isNameInferred
		sourceColumn: [County]

		annotation SummarizationSetBy = Automatic

	column AgeBand
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeBand]
		sortByColumn: AgeOrder

		annotation SummarizationSetBy = Automatic

	column AgeOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeOrder]

		annotation SummarizationSetBy = Automatic

	column Residents
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Residents]

		annotation SummarizationSetBy = Automatic

	column 'Median household income'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Median household income]

		annotation SummarizationSetBy = Automatic

	measure 'Context value (CountyProfiles)' = SUM(CountyProfiles[Residents])

	measure 'Population by age band (CountyProfiles)' = SUM(CountyProfiles[Residents])

	measure 'Median income by age (CountyProfiles)' = AVERAGE(CountyProfiles[Median household income])

	partition CountyProfiles = calculated
		mode: import
		source =
				DATATABLE(
				    "CountyKey", STRING,
				    "County", STRING,
				    "AgeBand", STRING,
				    "AgeOrder", INTEGER,
				    "Residents", DOUBLE,
				    "Median household income", DOUBLE,
