/// Offline synthetic sample data for Atlyn Profile Lens: world demographic profiles.
/// Defined as a DAX calculated table so the model has no data source, no credentials and
/// no refresh. Every value is generated by a deterministic function of the key and carries
/// no observation from any real statistical source.
/// Indicators are reported across five age bands: 0 to 17, 18 to 34, 35 to 49, 50 to 64, 65 and over.
table WorldProfiles

	column CountryKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [CountryKey]

		annotation SummarizationSetBy = Automatic

	column Country
		summarizeBy: none
		isNameInferred
		sourceColumn: [Country]

		annotation SummarizationSetBy = Automatic

	column Period
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period]

		annotation SummarizationSetBy = Automatic

	column AgeBand
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeBand]
		sortByColumn: AgeOrder

		annotation SummarizationSetBy = Automatic

	column AgeOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeOrder]

		annotation SummarizationSetBy = Automatic

	column Settlement
		summarizeBy: none
		isNameInferred
		sourceColumn: [Settlement]

		annotation SummarizationSetBy = Automatic

	column Residents
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Residents]

		annotation SummarizationSetBy = Automatic

	column 'Median household income'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Median household income]

		annotation SummarizationSetBy = Automatic

	column 'Degree attainment rate'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Degree attainment rate]

		annotation SummarizationSetBy = Automatic

	measure 'Context value (WorldProfiles)' = SUM(WorldProfiles[Residents])

	measure 'Population by age band (WorldProfiles)' = SUM(WorldProfiles[Residents])

	measure 'Median income by age (WorldProfiles)' = AVERAGE(WorldProfiles[Median household income])

	measure 'Degree attainment by age (WorldProfiles)' = AVERAGE(WorldProfiles[Degree attainment rate])

	partition WorldProfiles = calculated
		mode: import
		source =
				DATATABLE(
				    "CountryKey", STRING,
				    "Country", STRING,
				    "Period", STRING,
				    "AgeBand", STRING,
				    "AgeOrder", INTEGER,
				    "Settlement", STRING,
				    "Residents", DOUBLE,
				    "Median household income", DOUBLE,
				    "Degree attainment rate", DOUBLE,
