/// Offline synthetic sample data for Atlyn Profile Lens. Defined as a DAX
/// calculated table so the model has no data source, no credentials and no refresh.
/// The labels are deliberately generic.
table ProfileFacts

	column Entity
		summarizeBy: none
		isNameInferred
		sourceColumn: [Entity]

		annotation SummarizationSetBy = Automatic

	column WorldKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [WorldKey]

		annotation SummarizationSetBy = Automatic

	column StateKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [StateKey]

		annotation SummarizationSetBy = Automatic

	column CountyKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [CountyKey]

		annotation SummarizationSetBy = Automatic

	column Period
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period]

		annotation SummarizationSetBy = Automatic

	column Band
		summarizeBy: none
		isNameInferred
		sourceColumn: [Band]
		sortByColumn: BandOrder

		annotation SummarizationSetBy = Automatic

	column BandOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [BandOrder]

		annotation SummarizationSetBy = Automatic

	column Series
		summarizeBy: none
		isNameInferred
		sourceColumn: [Series]

		annotation SummarizationSetBy = Automatic

	column 'Metric A'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric A]

		annotation SummarizationSetBy = Automatic

	column 'Metric B'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric B]

		annotation SummarizationSetBy = Automatic

	column 'Metric C'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric C]

		annotation SummarizationSetBy = Automatic

	column Latitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Latitude]

		annotation SummarizationSetBy = Automatic

	column Longitude
		summarizeBy: none
		isNameInferred
		sourceColumn: [Longitude]

		annotation SummarizationSetBy = Automatic

	column Geometry
		summarizeBy: none
		isNameInferred
		sourceColumn: [Geometry]

		annotation SummarizationSetBy = Automatic

	measure 'Context value' = SUM(ProfileFacts[Metric A])

	measure 'Selected latitude' = SELECTEDVALUE(ProfileFacts[Latitude])

	measure 'Selected longitude' = SELECTEDVALUE(ProfileFacts[Longitude])

	measure 'Selected geometry' = SELECTEDVALUE(ProfileFacts[Geometry])

	partition ProfileFacts = calculated
		mode: import
		source =
				DATATABLE(
				    "Entity", STRING,
				    "WorldKey", STRING,
				    "StateKey", STRING,
				    "CountyKey", STRING,
				    "Period", STRING,
				    "Band", STRING,
				    "BandOrder", INTEGER,
				    "Series", STRING,
				    "Metric A", DOUBLE,
				    "Metric B", DOUBLE,
				    "Metric C", DOUBLE,
				    "Latitude", DOUBLE,
				    "Longitude", DOUBLE,
				    "Geometry", STRING,
