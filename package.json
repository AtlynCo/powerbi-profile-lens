{
  "name": "profile-lens-visual",
  "description": "Atlyn Profile Lens for Power BI: a generic report-bound profile and context explorer",
  "version": "1.5.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/garrett-hamers/powerbi-profile-lens"
  },
  "license": "MIT",
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "clean": "node scripts/clean.cjs",
    "install:clean": "node scripts/clean-install.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "check:capabilities": "node scripts/check-capabilities-conditions.mjs capabilities.json",
    "check:metadata": "node scripts/check-metadata.cjs",
    "check:forbidden": "node scripts/scan-forbidden-calls.cjs",
    "checks": "npm run check:capabilities && npm run check:metadata && npm run check:forbidden",
    "pretest": "npm run checks",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run clean && pbiviz package --certification-audit && node scripts/normalize-pbiviz.cjs",
    "audit:certification": "node scripts/certification-audit.cjs",
    "audit:reproducible": "node scripts/reproducibility-audit.cjs",
    "audit:npm": "npm audit --audit-level=moderate",
    "probe:build": "node scripts/build-probe-bundle.cjs",
    "probe:browser": "npm run package && npm run probe:build && playwright test --config=playwright.config.ts",
    "release:manifest": "node scripts/release-manifest.cjs",
    "sample:pbip": "node scripts/build-sample-report.cjs",
    "assets:brand": "node scripts/generate-brand-assets.cjs",
    "packs:fetch": "node scripts/context-packs.mjs fetch",
    "packs:build": "node scripts/context-packs.mjs build",
    "packs:validate": "node scripts/context-packs.mjs validate",
    "packs:verify": "node scripts/context-packs.mjs verify",
    "packs:repro": "node scripts/context-packs.mjs repro",
    "validate:certification": "npm run audit:npm && npm run packs:fetch && npm run packs:validate && npm run packs:verify && npm run packs:repro && npm run lint && npm run typecheck && npm run package && npm run sample:pbip && npm test && npm run audit:certification && npm run probe:browser && npm run audit:reproducible && npm run release:manifest"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "powerbi-visuals-api": "5.11.0",
    "powerbi-visuals-utils-formattingmodel": "7.1.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/d3-geo": "3.1.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "happy-dom": "20.11.0",
    "jszip": "3.10.1",
    "less": "4.8.1",
    "powerbi-visuals-tools": "7.2.1",
    "shapefile": "0.6.6",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "write-file-atomic": "6.0.0"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
