/// Offline synthetic sample data for Atlyn Profile Lens: diagnostics demographic profiles.
/// Defined as a DAX calculated table so the model has no data source, no credentials and
/// no refresh. Every value is generated by a deterministic function of the key and carries
/// no observation from any real statistical source.
/// Indicators are reported across five age bands: 0 to 17, 18 to 34, 35 to 49, 50 to 64, 65 and over.
table KeyDiagnostics

	column SuppliedKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [SuppliedKey]

		annotation SummarizationSetBy = Automatic

	column KeyNote
		summarizeBy: none
		isNameInferred
		sourceColumn: [KeyNote]

		annotation SummarizationSetBy = Automatic

	column AgeBand
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeBand]
		sortByColumn: AgeOrder

		annotation SummarizationSetBy = Automatic

	column AgeOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [AgeOrder]

		annotation SummarizationSetBy = Automatic

	column Residents
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Residents]

		annotation SummarizationSetBy = Automatic

	column 'Median household income'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Median household income]

		annotation SummarizationSetBy = Automatic

	measure 'Context value' = SUM(KeyDiagnostics[Residents])

	measure 'Population by age band' = SUM(KeyDiagnostics[Residents])

	measure 'Median income by age' = AVERAGE(KeyDiagnostics[Median household income])

	partition KeyDiagnostics = calculated
		mode: import
		source =
				DATATABLE(
				    "SuppliedKey", STRING,
				    "KeyNote", STRING,
				    "AgeBand", STRING,
				    "AgeOrder", INTEGER,
				    "Residents", DOUBLE,
				    "Median household income", DOUBLE,
				    {
				        {"USA", "Exact canonical key", "0 to 17", 1, 20.6, 32.8},
				        {"USA", "Exact canonical key", "18 to 34", 2, 21.8, 63.1},
				        {"USA", "Exact canonical key", "35 to 49", 3, 19.1, 83.9},
				        {"USA", "Exact canonical key", "50 to 64", 4, 19.3, 80.8},
				        {"USA", "Exact canonical key", "65 and over", 5, 17.4, 51.4},
				        {"DEU", "Exact canonical key", "0 to 17", 1, 21.6, 39.7},
				        {"DEU", "Exact canonical key", "18 to 34", 2, 22.9, 76.2},
				        {"DEU", "Exact canonical key", "35 to 49", 3, 20, 100.9},
				        {"DEU", "Exact canonical key", "50 to 64", 4, 20.2, 96.8},
				        {"DEU", "Exact canonical key", "65 and over", 5, 18.2, 61.4},
				        {"FRA", "Rejected: duplicate after ASCII case fold", "0 to 17", 1, 22.1, 33.1},
				        {"FRA", "Rejected: duplicate after ASCII case fold", "18 to 34", 2, 23.3, 63.7},
				        {"FRA", "Rejected: duplicate after ASCII case fold", "35 to 49", 3, 20.4, 84.7},
				        {"FRA", "Rejected: duplicate after ASCII case fold", "50 to 64", 4, 20.6, 81.5},
				        {"FRA", "Rejected: duplicate after ASCII case fold", "65 and over", 5, 18.6, 51.9},
				        {"fra", "Rejected: duplicate after ASCII case fold", "0 to 17", 1, 18.5, 40.7},
				        {"fra", "Rejected: duplicate after ASCII case fold", "18 to 34", 2, 19.6, 77.9},
				        {"fra", "Rejected: duplicate after ASCII case fold", "35 to 49", 3, 17.2, 103.1},
				        {"fra", "Rejected: duplicate after ASCII case fold", "50 to 64", 4, 17.4, 98.9},
				        {"fra", "Rejected: duplicate after ASCII case fold", "65 and over", 5, 15.8, 62.7},
				        {" USA ", "Rejected: padded whitespace", "0 to 17", 1, 18.7, 39.9},
				        {" USA ", "Rejected: padded whitespace", "18 to 34", 2, 19.8, 76.5},
				        {" USA ", "Rejected: padded whitespace", "35 to 49", 3, 17.4, 101.3},
				        {" USA ", "Rejected: padded whitespace", "50 to 64", 4, 17.6, 97.1},
				        {" USA ", "Rejected: padded whitespace", "65 and over", 5, 15.9, 61.6},
				        {"XX", "Rejected: no exact feature", "0 to 17", 1, 21.4, 41.5},
				        {"XX", "Rejected: no exact feature", "18 to 34", 2, 22.6, 79.4},
				        {"XX", "Rejected: no exact feature", "35 to 49", 3, 19.8, 105.1},
				        {"XX", "Rejected: no exact feature", "50 to 64", 4, 20, 100.7},
				        {"XX", "Rejected: no exact feature", "65 and over", 5, 18, 63.9},
				        {" 06037", "Rejected: padded county GEOID in a country pack", "0 to 17", 1, 20.8, 33.5},
				        {" 06037", "Rejected: padded county GEOID in a country pack", "18 to 34", 2, 22, 64.5},
				        {" 06037", "Rejected: padded county GEOID in a country pack", "35 to 49", 3, 19.2, 85.7},
				        {" 06037", "Rejected: padded county GEOID in a country pack", "50 to 64", 4, 19.4, 82.5},
				        {" 06037", "Rejected: padded county GEOID in a country pack", "65 and over", 5, 17.5, 52.5},
				        {"NE:KOS", "Rejected: not an ISO alpha-3 code", "0 to 17", 1, 20.3, 37.7},
				        {"NE:KOS", "Rejected: not an ISO alpha-3 code", "18 to 34", 2, 21.5, 72.3},
				        {"NE:KOS", "Rejected: not an ISO alpha-3 code", "35 to 49", 3, 18.8, 95.9},
				        {"NE:KOS", "Rejected: not an ISO alpha-3 code", "50 to 64", 4, 19, 92.1},
				        {"NE:KOS", "Rejected: not an ISO alpha-3 code", "65 and over", 5, 17.2, 58.5}
				    }
				)
