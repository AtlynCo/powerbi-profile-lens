{
  "privileges": [],
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "keepAllMetadataColumns": true,
  "tooltips": {
    "roles": [
      "Tooltips"
    ],
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "supportEnhancedTooltips": true
  },
  "dataRoles": [
    {
      "name": "Hierarchy",
      "displayName": "Entity > Period > Band",
      "displayNameKey": "Role_Hierarchy",
      "description": "Ordered grouping fields: entity first, then an optional period, then the ordered band.",
      "descriptionKey": "Role_Hierarchy_Description",
      "kind": "Grouping"
    },
    {
      "name": "Series",
      "displayName": "Series",
      "displayNameKey": "Role_Series",
      "description": "Optional split with at most two rendered values.",
      "descriptionKey": "Role_Series_Description",
      "kind": "Grouping"
    },
    {
      "name": "Profiles",
      "displayName": "Profile measures",
      "displayNameKey": "Role_Profiles",
      "description": "One to six numeric measures. Each measure becomes one profile arm.",
      "descriptionKey": "Role_Profiles_Description",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        },
        {
          "integer": true
        }
      ]
    },
    {
      "name": "ContextValue",
      "displayName": "Context value",
      "displayNameKey": "Role_ContextValue",
      "description": "Optional entity-level value used by context features and tooltips.",
      "descriptionKey": "Role_ContextValue_Description",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        },
        {
          "integer": true
        }
      ]
    },
    {
      "name": "Latitude",
      "displayName": "Latitude",
      "displayNameKey": "Role_Latitude",
      "description": "Optional WGS84 latitude measure for bound point context.",
      "descriptionKey": "Role_Latitude_Description",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        },
        {
          "integer": true
        }
      ]
    },
    {
      "name": "Longitude",
      "displayName": "Longitude",
      "displayNameKey": "Role_Longitude",
      "description": "Optional WGS84 longitude measure for bound point context.",
      "descriptionKey": "Role_Longitude_Description",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        },
        {
          "integer": true
        }
      ]
    },
    {
      "name": "Geometry",
      "displayName": "Custom geometry text",
      "displayNameKey": "Role_Geometry",
      "description": "Optional strict GeoJSON or WKT text measure for report-bound context.",
      "descriptionKey": "Role_Geometry_Description",
      "kind": "Measure",
      "requiredTypes": [
        {
          "text": true
        }
      ]
    },
    {
      "name": "Tooltips",
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "description": "Additional fields shown in the native tooltip.",
      "descriptionKey": "Role_Tooltips_Description",
      "kind": "GroupingOrMeasure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "Hierarchy": {
            "max": 3
          },
          "Series": {
            "max": 1
          },
          "Profiles": {
            "max": 6
          },
          "ContextValue": {
            "max": 1
          },
          "Latitude": {
            "max": 1
          },
          "Longitude": {
            "max": 1
          },
          "Geometry": {
            "max": 1
          },
          "Tooltips": {
            "max": 10
          }
        }
      ],
      "matrix": {
        "rows": {
          "for": {
            "in": "Hierarchy"
          },
          "dataReductionAlgorithm": {
            "window": {
              "count": 4000
            }
          }
        },
        "columns": {
          "for": {
            "in": "Series"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 3
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "Profiles"
              }
            },
            {
              "bind": {
                "to": "ContextValue"
              }
            },
            {
              "bind": {
                "to": "Latitude"
              }
            },
            {
              "bind": {
                "to": "Longitude"
              }
            },
            {
              "bind": {
                "to": "Geometry"
              }
            },
            {
              "for": {
                "in": "Tooltips"
              }
            }
          ]
        }
      }
    }
  ],
