{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "visualProgressiveAuthoring",
  "position": {
    "x": 40,
    "y": 40,
    "z": 0,
    "height": 800,
    "width": 1520,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "atlynProfileLens",
    "query": {
      "queryState": {
        "Hierarchy": {
          "projections": []
        },
        "Profiles": {
          "projections": []
        }
      }
    },
    "objects": {
      "data": [
        {
          "properties": {
            "normalization": {
              "expr": {
                "Literal": {
                  "Value": "'shareOfProfile'"
                }
              }
            },
            "percentScale": {
              "expr": {
                "Literal": {
                  "Value": "'fraction'"
                }
              }
            }
          }
        }
      ],
      "layout": [
        {
          "properties": {
            "contextLayout": {
              "expr": {
                "Literal": {
                  "Value": "'profileOnly'"
                }
              }
            }
          }
        }
      ],
      "context": [
        {
          "properties": {
            "mode": {
              "expr": {
                "Literal": {
                  "Value": "'none'"
                }
              }
            },
            "pack": {
              "expr": {
                "Literal": {
                  "Value": "'worldCountries'"
                }
              }
            },
            "worldDetail": {
              "expr": {
                "Literal": {
                  "Value": "'110m'"
                }
              }
            },
            "referenceDetail": {
              "expr": {
                "Literal": {
                  "Value": "'standard'"
                }
              }
            },
            "showPhysicalLayers": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showLabels": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "labelDensity": {
              "expr": {
                "Literal": {
                  "Value": "'balanced'"
                }
              }
            },
            "showGraticule": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "packKeyMode": {
              "expr": {
                "Literal": {
                  "Value": "'auto'"
                }
              }
            }
          }
        }
      ],
      "diagnostics": [
        {
          "properties": {
            "showDiagnostics": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "interaction": [
        {
          "properties": {
            "mode": {
              "expr": {
                "Literal": {
                  "Value": "'reportSelection'"
                }
              }
            }
          }
        }
      ],
      "navigation": [
        {
          "properties": {
            "minZoom": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            },
            "homeView": {
              "expr": {
                "Literal": {
                  "Value": "'automatic'"
                }
              }
            },
            "maxZoom": {
              "expr": {
                "Literal": {
                  "Value": "8D"
                }
              }
            },
            "wheelSensitivity": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            },
            "showCenterProbe": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showResetControl": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showGestureHelp": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showNoDataBackdrop": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
