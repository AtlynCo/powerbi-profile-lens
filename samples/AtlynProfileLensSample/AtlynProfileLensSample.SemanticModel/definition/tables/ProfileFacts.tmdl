/// Offline synthetic sample data for the Atlyn Profile Lens listing. Defined as a DAX
/// calculated table so the model has no data source, no credentials and no refresh.
/// The labels are deliberately generic and carry no business or demographic meaning.
table ProfileFacts

	column Entity
		summarizeBy: none
		isNameInferred
		sourceColumn: [Entity]

		annotation SummarizationSetBy = Automatic

	column Period
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period]

		annotation SummarizationSetBy = Automatic

	column Band
		summarizeBy: none
		isNameInferred
		sourceColumn: [Band]
		sortByColumn: BandOrder

		annotation SummarizationSetBy = Automatic

	column BandOrder
		summarizeBy: none
		isNameInferred
		sourceColumn: [BandOrder]

		annotation SummarizationSetBy = Automatic

	column Series
		summarizeBy: none
		isNameInferred
		sourceColumn: [Series]

		annotation SummarizationSetBy = Automatic

	column 'Metric A'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric A]

		annotation SummarizationSetBy = Automatic

	column 'Metric B'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric B]

		annotation SummarizationSetBy = Automatic

	column 'Metric C'
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Metric C]

		annotation SummarizationSetBy = Automatic

	partition ProfileFacts = calculated
		mode: import
		source =
				DATATABLE(
				    "Entity", STRING,
				    "Period", STRING,
				    "Band", STRING,
				    "BandOrder", INTEGER,
				    "Series", STRING,
